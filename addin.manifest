# This addin, for the shared installer in mpc-vst-plugins (tools/release/addin; the keys are in its docs/ADDINS.md).
ADDIN_ID=remote
ADDIN_NAME="MPC Remote addin"
ADDIN_SO=mpc_remote_addin.so
ADDIN_CONF=mpc_remote_addin.conf
ADDIN_FILES="standalone"
ADDIN_NETWORK=1
ADDIN_DONE="It listens on the device only. From your computer: ssh -L 6720:127.0.0.1:6720 root@<device address>, then open http://localhost:6720 (bind and port are in mpc_remote_addin.conf)."
